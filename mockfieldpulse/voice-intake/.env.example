# Copy this file to .env and fill in real values. .env is gitignored.

# Anthropic API key for the extractor (Claude).
ANTHROPIC_API_KEY=sk-ant-...

# Mock FieldPulse connection (defaults shown).
FIELDPULSE_BASE_URL=http://localhost:5000
FIELDPULSE_API_KEY=dev-test-key-12345
# Optional, orchestrator only: list customers from REAL FieldPulse, read-only (GET).
# Leave both unset to read the mock. Never set these on the worker.
# FIELDPULSE_READ_BASE_URL=https://ywe3crmpll.execute-api.us-east-2.amazonaws.com/stage
# FIELDPULSE_READ_API_KEY=

# --- Real FieldPulse WRITES (fieldpulse_sync.py). WORKER ONLY. ----------------
# Staged rollout. FIELDPULSE_WRITE_MODE:
#   dry_run             DEFAULT (also used for unset or any unknown value). Builds and
#                       records the exact requests in Postgres (fieldpulse_writes); sends NOTHING.
#   off                 Do nothing at all.
#   test_customer_only  Send ONLY for FIELDPULSE_TEST_CUSTOMER_ID (stage 4).
#   live                Send for every customer. Needs Nick's explicit go.
# Sending also needs the two WRITE vars below. They are deliberately different from the
# mock's FIELDPULSE_BASE_URL/_API_KEY and the picker's FIELDPULSE_READ_* (never reused).
# FIELDPULSE_WRITE_MODE=dry_run
# FIELDPULSE_WRITE_BASE_URL=https://ywe3crmpll.execute-api.us-east-2.amazonaws.com/stage
# FIELDPULSE_WRITE_API_KEY=
# FIELDPULSE_TEST_CUSTOMER_ID=          # real FieldPulse customer id (integer) of the test customer
# Optional:
# FIELDPULSE_TIMEZONE=America/Chicago   # branch timezone for task start/end epoch seconds (doc §8)
# FIELDPULSE_COMMENT_COMMENTABLE_TYPE=customer   # UNVERIFIED value for comments on a customer
# FIELDPULSE_AI_JOB_TAG_ID=             # job tag id to put on tasks (unset = no tag; write shape UNVERIFIED)
# ADMIN_BASE_URL=                       # the React app URL; adds "Full transcript and details: <url>/#admin/<job_id>" to comments

# Clerk authentication. The orchestrator verifies incoming session tokens
# against Clerk before running any protected route — required to boot.
# Grab from Clerk dashboard → API Keys:
#   - Secret key  (sk_test_... or sk_live_...)  — server-only, keep secret
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
# Comma-separated list of origins allowed to send Clerk tokens to this
# orchestrator (guards against a token issued for a different app being
# replayed here). Include every host the app runs on.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Legacy shared auth key. Retired in Chunk B — Clerk sessions are now the
# real gate. This var is kept only so old scripts referencing it don't crash
# reading env; the orchestrator no longer checks it.
INTAKE_API_KEY=dev-intake-key

# Cloudflare R2 (S3-compatible) for consultation audio storage. Get these
# from Cloudflare dashboard → R2 → Manage R2 API Tokens. The endpoint URL
# uses your account id, NOT the bucket name.
R2_ENDPOINT_URL=https://abc123def456.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=threeday-consultations

# Redis (for the async consultation queue via RQ). Defaults to local
# Homebrew Redis; on Render use the Redis add-on's connection URL.
REDIS_URL=redis://localhost:6379
